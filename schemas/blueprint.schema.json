{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.4-draft"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "intent_ref": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
    },
    "discoveries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "observed",
              "hypothesis",
              "unknown"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "response": {
            "type": "string",
            "minLength": 1
          },
          "review_trigger": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "description",
          "basis",
          "status",
          "scope",
          "response",
          "review_trigger"
        ],
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "expectation": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "due_before": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "mandatory": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "origin",
          "expectation",
          "condition",
          "due_before",
          "verification",
          "mandatory"
        ],
        "additionalProperties": false
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "enum": [
              "reused",
              "adapted",
              "composed",
              "project_invented"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "outcome_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "failure_response": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "trial",
              "selected",
              "deferred",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "origin",
          "basis",
          "purpose",
          "scope",
          "prerequisites",
          "activities",
          "artifact_ids",
          "outcome_ids",
          "verification",
          "failure_response",
          "rationale",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "mission": {
            "type": "string",
            "minLength": 1
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "knowledge": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "mission",
          "responsibilities",
          "knowledge"
        ],
        "additionalProperties": false
      }
    },
    "collaborations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_role": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "to_role": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "contract": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from_role",
          "to_role",
          "contract"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "owner_role": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          }
        },
        "required": [
          "id",
          "name",
          "format",
          "purpose",
          "owner_role"
        ],
        "additionalProperties": false
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "outcome_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "blocked_scope": {
            "type": "string",
            "minLength": 1
          },
          "continue_work": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "outcome_id",
          "reason",
          "blocked_scope",
          "continue_work"
        ],
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "intent_protection": {
          "type": "string",
          "minLength": 1
        },
        "github_policy": {
          "type": "string",
          "minLength": 1
        },
        "authority_boundary": {
          "type": "string",
          "minLength": 1
        },
        "quality_policy": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "string",
          "minLength": 1
        },
        "handoff": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "intent_protection",
        "github_policy",
        "authority_boundary",
        "quality_policy",
        "budget",
        "handoff"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "intent_ref",
    "discoveries",
    "outcomes",
    "methods",
    "roles",
    "collaborations",
    "artifacts",
    "holds",
    "governance"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

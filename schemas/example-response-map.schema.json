{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "stimulus_unit": {
      "type": "string",
      "minLength": 1
    },
    "response_unit": {
      "type": "string",
      "minLength": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "time_ms": {
            "type": "number",
            "minimum": 0
          },
          "stimulus": {
            "type": "number"
          },
          "response": {
            "type": "number"
          }
        },
        "required": [
          "time_ms",
          "stimulus",
          "response"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "stimulus_unit",
    "response_unit",
    "samples"
  ],
  "additionalProperties": false
}
